# FMO Repeater 服务配置文件示例
#
# 本配置文件使用 YAML 格式
# 复制此文件为 config.yaml 并根据实际情况修改配置
#
# 重要提示：
# - 请勿将包含真实密码的 config.yaml 文件提交到版本控制系统
# - 生产环境中应使用环境变量或其他安全方式管理敏感信息

# MQTT 代理配置
mqtt:
  broker: "your-mqtt-broker.com"  # MQTT 代理地址
  port: 1883                       # MQTT 代理端口
  username: "your_username"        # 用户名
  password: "your_password"        # 密码
  client_id_prefix: "fmo_repeater" # 客户端 ID 前缀，实际 ID 为 prefix_随机数
  keepalive: 60                    # 保持连接的心跳间隔（秒）

# 主题配置
topics:
  subscribe: "FMO/RAW"  # 订阅的主题（接收原始 FMO 消息包）
  publish: "FMO/RAW"    # 发布的主题（重放修改后的消息包）

# 单信道 PTT 识别与协议 §8 仲裁
transmission:
  idle_timeout: 2.0          # 最后一包后满 2 秒，封口为一次 PTT 完成事件
  max_uplink_duration: 60    # 连续上行限制：0（不限）或 30/60/90/120 秒

# Echo 服务配置
echo:
  max_duration: 30.0        # 回放时长上限（秒）：缓存跨度超过则只重放前 30 秒
  vendor: 0x2000            # 重放时写入的厂家标识（软件区 0x2000-0x2FFF 自由取用；
                            # 严禁使用保留区 0x0000-0x0FFF；正式区 0x3000+ 需登记）
  uid: 65535                # 重放时写入的 UID；勿设 0（保持原值会被客户端按
                            # "自己发的"自过滤，设备收不到回声）
  callsign_prefix: "RE>"    # 呼号前缀，原始呼号 "BD8BOJ" 变为 "RE>BD8BOJ"

# 结构化事件日志（JSONL，每行一个 JSON 事件）
event_log:
  enabled: true                     # 是否启用
  file: "logs/events.jsonl"         # 事件日志文件路径
  max_bytes: 10485760               # 单文件最大字节数（轮转）
  backup_count: 5                   # 轮转保留份数

# 运行日志（可读文本）
logging:
  level: "INFO"                     # 日志级别: DEBUG, INFO, WARNING, ERROR, CRITICAL
  console: true                     # 是否输出到控制台
  file: "logs/fmo_repeater.log"     # 日志文件路径
  max_bytes: 10485760               # 单个日志文件最大大小（10MB）
  backup_count: 5                   # 保留的日志文件备份数量

# 守护进程配置
daemon:
  enabled: false                    # 是否启用守护进程模式
  pid_file: "/var/run/fmo_repeater.pid" # PID 文件路径（仅守护进程模式使用）

# 使用说明：
# 1. 复制此文件：cp config.yaml.example config.yaml
# 2. 编辑 config.yaml，填入实际的配置信息
# 3. 运行服务：python main.py start
